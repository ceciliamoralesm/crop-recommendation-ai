{
  "openapi": "3.1.0",
  "info": {
    "title": "Crop Recommendation AI",
    "description": "Servicio de IA que recomienda el cultivo más adecuado según las condiciones del suelo (N, P, K, pH) y del clima (temperatura, humedad, lluvia).\n\nModelo: RandomForest multiclase (22 cultivos), entrenado siguiendo CRISP-ML(Q).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/predict": {
      "post": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Recomendar un cultivo",
        "description": "Envía las condiciones del suelo y el clima al modelo activo y devuelve el cultivo recomendado,\nsu confianza y el top 3. La predicción se guarda en el historial.",
        "operationId": "predict_api_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "503": {
            "description": "No hay modelo activo"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/predictions": {
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Historial de predicciones",
        "description": "Devuelve las predicciones previas (datos enviados y resultado), de la más reciente a la más antigua.",
        "operationId": "list_predictions_api_predictions_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Size"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por cultivo predicho",
              "title": "Label"
            },
            "description": "Filtrar por cultivo predicho"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/predictions/{prediction_id}": {
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Detalle de una predicción",
        "operationId": "get_prediction_api_predictions__prediction_id__get",
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Prediction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Métricas del modelo activo",
        "description": "Accuracy, precision, recall y F1 (macro), F1 de validación cruzada, matriz de confusión,\nmétricas por clase e importancia de variables.",
        "operationId": "metrics_api_metrics_get",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versión concreta; si se omite, la activa",
              "title": "Version"
            },
            "description": "Versión concreta; si se omite, la activa"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetrics"
                }
              }
            }
          },
          "404": {
            "description": "No hay modelo activo"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/retrain": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Re-entrenar el modelo",
        "description": "Entrena una nueva versión con todos los datasets activos de la base de datos. El nuevo modelo\nse activa si su F1 macro no empeora más que la tolerancia configurada (o si `force=true`).",
        "operationId": "retrain_api_retrain_post",
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Activar el nuevo modelo aunque tenga peor F1",
              "default": false,
              "title": "Force"
            },
            "description": "Activar el nuevo modelo aunque tenga peor F1"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrainResponse"
                }
              }
            }
          },
          "409": {
            "description": "Re-entrenamiento en curso"
          },
          "422": {
            "description": "Datos insuficientes"
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Versiones del modelo",
        "operationId": "list_models_api_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelSummary"
                  },
                  "type": "array",
                  "title": "Response List Models Api Models Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/models/{version}/activate": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Activar una versión (rollback)",
        "operationId": "activate_api_models__version__activate_post",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/upload": {
      "post": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Subir archivo de entrenamiento (CSV)",
        "description": "Valida el archivo (columnas, tipos, rangos y duplicados), lo guarda en la base de datos y,\nopcionalmente, re-entrena el modelo.",
        "operationId": "upload_api_datasets_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_api_datasets_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "413": {
            "description": "Archivo demasiado grande"
          },
          "422": {
            "description": "CSV inválido"
          }
        }
      }
    },
    "/api/datasets": {
      "get": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Datasets cargados y distribución de clases",
        "operationId": "summary_api_datasets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/{dataset_id}": {
      "patch": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Activar/desactivar un dataset",
        "operationId": "toggle_api_datasets__dataset_id__patch",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Dataset Id"
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "title": "Is Active"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/template": {
      "get": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Descargar plantilla CSV",
        "operationId": "template_api_datasets_template_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_api_datasets_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CSV con columnas N,P,K,temperature,humidity,ph,rainfall,label"
          },
          "mode": {
            "type": "string",
            "enum": [
              "append",
              "replace"
            ],
            "title": "Mode",
            "description": "append: se suma a los datos actuales; replace: sustituye a los datos activos",
            "default": "append"
          },
          "retrain": {
            "type": "boolean",
            "title": "Retrain",
            "description": "Re-entrenar automáticamente tras la carga",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_datasets_upload_post"
      },
